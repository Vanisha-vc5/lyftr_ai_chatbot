# ---- LLM (Groq via LiteLLM) -------------------------------------------------
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=gsk_your_first_key_here,gsk_your_second_key_here
# Default model for every key (LiteLLM provider-prefixed string)
LLM_MODEL=groq/openai/gpt-oss-20b
# Optional per-key models aligned with LLM_API_KEYS; blank entries fall back to LLM_MODEL
LLM_MODELS=
# Fixed generation params (part of the cache key, keep them constant)
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_REASONING_EFFORT=low
# Per-attempt timeout in seconds
LLM_TIMEOUT_SECONDS=30

# ---- Storage ------------------------------------------------------------------
DATABASE_URL=sqlite:////data/app.db
# disk (persists on the /data volume) or local (in-memory)
CACHE_TYPE=disk
CACHE_DIR=/data/litellm_cache
CACHE_TTL_SECONDS=86400
# Most recent N stored messages sent to the LLM as context
HISTORY_MAX_MESSAGES=20

# ---- HTTP -----------------------------------------------------------------------
# Comma-separated CORS origins (add your Vercel URL in production)
ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel preview URLs: https://vani-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
# Honor the X-Simulate-Failure header (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true
# Serve /docs and /openapi.json (off: the contract is exactly three endpoints)
ENABLE_API_DOCS=false
LOG_LEVEL=INFO
# Railway injects PORT; locally the backend listens on 8000
PORT=8000
# Optional: override the built-in Vani system prompt (static text only, no dates)
# DEFAULT_SYSTEM_PROMPT=You are Vani, a helpful and concise AI assistant.

# ---- Frontend -------------------------------------------------------------------
# Backend URL the browser calls
VITE_API_BASE_URL=http://localhost:8000
